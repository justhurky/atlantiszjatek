# Sablon a beállításokhoz. Másold le .env néven a projekt mappájába: a szerver induláskor beolvassa.
# (A terminálban megadott környezeti változók elsőbbséget élveznek a .env-ben lévőkkel szemben.)
# Az üresen hagyott sorok alapértéket jelentenek. A titkokat a szerver magától generálja, ha nincsenek megadva.

PORT=3000
# A játék címe (erre mutatnak a QR-kódok). Üresen: a gép helyi hálózati címe (pl. http://192.168.1.20:3000)
BASE_URL=

# Titkok és a kapukód. Üresen: a szerver első induláskor generálja és a data/secrets.json fájlba menti.
SESSION_SECRET=
GATE_QR_SECRET=
# A kapuban megjelenő kód, amit a csapatok beírnak (üresen: pl. KORALL42)
GATE_CODE=

# A "régi üzenet" állomás megoldó szava (alapból: ORÁKULUM, ez csak felülírja)
LETTERS_ANSWER=

# A játék vége (a szerver gépének helyi ideje). Utána nincs új csapat és válasz, a ranglista végleges.
GAME_END_AT=2026-10-27 22:00
# A játék végén és a ranglistán megjelenő megjegyzés
RESULTS_NOTE=Eredményhirdetés 23:00 után, értékes nyereményekkel!
# Az időpontok időzónája (felhőben a szerver órája gyakran UTC)
TIME_ZONE=Europe/Budapest

# Admin felület: jelszó nincs. A szerver gépén a http://localhost:3000/admin mindig megnyílik,
# a szervezők telefonjára pedig a konzolon kiírt szervezői link (/admin/<kulcs>) kell.
# ADMIN_KEY üresen: a szerver generál egyet, és a data/admin-key.txt fájlba menti.
ADMIN_KEY=
# 0 = a szerver gépén is kell a szervezői link
ADMIN_LOCAL=1

# Csak HTTPS-proxy (pl. nginx) mögött: 1
TRUST_PROXY=

# Élesben: NODE_ENV=production

# Segítség (tipp): ennyi idő (ms) vagy rossz válasz után kérhető, ennyi büntetéssel (ms)
HINT_AFTER_MS=120000
HINT_AFTER_WRONG=2
HINT_PENALTY_MS=120000

# Kivetíthető ranglista kikapcsolása: 0
PUBLIC_BOARD=

# Mentés helye (újraindítás után folytatható játék)
DATA_FILE=data/state.json

# Adatkezelési tájékoztató (/adatvedelem)
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_DPO=
PRIVACY_HOSTING=
PRIVACY_EVENT=
PRIVACY_UPDATED=
# A fotók automatikus törlése ennyi nap után
PHOTO_RETENTION_DAYS=30
